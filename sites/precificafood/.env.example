# Projeto Supabase (Settings → API). A anon key é pública: a segurança vem da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# URL pública do app (usada nos links de confirmação e de redefinição de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Não existe service_role no app: nenhuma chave privada é necessária no frontend nem no servidor.
